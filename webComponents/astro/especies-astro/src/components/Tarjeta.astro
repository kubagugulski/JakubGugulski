---
const { href } = Astro.props;
---
<a class="tarjeta" href={href}>
  <div class="tarjeta-icono"><slot name="icono">🌱</slot></div>
  <div class="tarjeta-cuerpo">
    <h2><slot name="titulo">Sin título</slot></h2>
    <slot />
  </div>
</a>

<style>
  .tarjeta {
    display: block;
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,.08);
    transition: transform .18s, box-shadow .18s;
    color: inherit;
    text-decoration: none;
  }
  .tarjeta:hover {
    transform: translateY(-4px);
    box-shadow: 0 6px 20px rgba(0,0,0,.14);
  }
  .tarjeta-icono {
    font-size: 3rem;
    text-align: center;
    padding: 1.2rem 0 0.6rem;
    background: linear-gradient(135deg, #d4f4dd, #a8d8b8);
  }
  .tarjeta-cuerpo {
    padding: 0.8rem 1rem 1rem;
  }
  h2 {
    font-size: 1rem;
    font-weight: 700;
  }
</style>